{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {"type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/user_prompt_submit_mint_token.py\""}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {"type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/post_tool_use_nudge.py\""}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/session_end_backstop.py\""}
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {"type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/session_end_backstop.py\""}
        ]
      }
    ]
  }
}

{
  "mcpServers": {
    "sag": {
      "type": "http",
      "url": "${SAG_URL}/mcp/",
      "headers": {
        "Authorization": "Bearer ${SAG_READ_TOKEN}"
      }
    },
    "sagw": {
      "command": "sagctl",
      "args": ["serve-mcp"],
      "env": {
        "SAGCTL_AGENT": "claude-code",
        "SAGCTL_STATE_URL": "${SAGCTL_STATE_URL}",
        "SAGCTL_STATE_TOKEN": "${SAGCTL_STATE_TOKEN}"
      }
    }
  }
}

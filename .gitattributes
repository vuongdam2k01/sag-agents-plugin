# Normalize line endings — the engine is developed on Windows and runs in CI on Linux.
* text=auto eol=lf

# Shell scripts must keep LF even on a Windows checkout, or they will not execute.
*.sh text eol=lf

# Windows-only helpers keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Don't ship development-only paths in a release tarball.
.github/        export-ignore
tests/          export-ignore
.gitattributes  export-ignore
.gitignore      export-ignore
